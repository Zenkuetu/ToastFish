<Window x:Class="ToastFish.View.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Background="#FF1F1F1F"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Width="420"
        Height="160"
        Loaded="Window_Loaded">
    <Border CornerRadius="8" BorderBrush="#FF444444" BorderThickness="1" Padding="16,12">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="#FF888888" FontSize="11" Margin="0,0,0,6"
                       Text="ToastFish" FontFamily="Microsoft YaHei UI"/>
            <TextBlock x:Name="BodyText" Foreground="White" FontSize="14" TextWrapping="Wrap"
                       MaxWidth="380" FontFamily="Microsoft YaHei UI" Margin="0,0,0,10"/>
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
