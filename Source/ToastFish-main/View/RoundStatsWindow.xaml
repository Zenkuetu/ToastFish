<Window x:Class="ToastFish.View.RoundStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToastFish · 本轮完成" Height="250" Width="340"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FAFAFA" Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 图标 + 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,10">
            <TextBlock Text="✅" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="本轮学习完成" FontSize="18" FontWeight="Bold"
                       FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 统计信息 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,5">
            <TextBlock x:Name="TotalText" Text="本轮 0 词" FontSize="15"
                       FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center"
                       Foreground="#1565C0" Margin="0,3"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                <Border Background="#E8F5E9" CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="NewText" Text="新学 0" FontSize="13" FontWeight="Bold"
                                   FontFamily="Microsoft YaHei UI" Foreground="#2E7D32"/>
                        <TextBlock Text="首次学习" FontSize="10" FontFamily="Microsoft YaHei UI"
                                   Foreground="#666"/>
                    </StackPanel>
                </Border>
                <Border Background="#E3F2FD" CornerRadius="4" Padding="12,6">
                    <StackPanel>
                        <TextBlock x:Name="ReviewText" Text="复习 0" FontSize="13" FontWeight="Bold"
                                   FontFamily="Microsoft YaHei UI" Foreground="#1565C0"/>
                        <TextBlock Text="已学巩固" FontSize="10" FontFamily="Microsoft YaHei UI"
                                   Foreground="#666"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 按钮 -->
        <Button Grid.Row="3" Content="关闭" Width="180" Height="40"
                FontSize="15" FontWeight="Bold" FontFamily="Microsoft YaHei UI"
                Background="#1565C0" Foreground="White" BorderThickness="0"
                Cursor="Hand" Click="CloseButton_Click"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10"/>
    </Grid>
</Window>
