<Window x:Class="ToastFish.View.AutoStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToastFish 自启动设置" Height="240" Width="440"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="ToastFish 开机自启动" FontSize="16" FontWeight="Bold"
                   FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center" Margin="0,15,0,10"/>

        <!-- 状态行 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
            <TextBlock Text="当前状态：" FontSize="13" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="5,0"/>
            <TextBlock x:Name="StatusText" Text="检测中..." FontSize="13" FontWeight="Bold"
                       FontFamily="Microsoft YaHei UI" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- 路径 -->
        <TextBlock Grid.Row="2" x:Name="PathText" Text="" FontSize="9" FontFamily="Consolas"
                   Foreground="#888" HorizontalAlignment="Center" Margin="0,8"
                   TextWrapping="Wrap" MaxWidth="380"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button x:Name="ToggleButton" Content="开启开机自启动" Width="150" Height="32"
                    FontSize="13" FontFamily="Microsoft YaHei UI" Click="ToggleButton_Click" Margin="0,0,10,0"/>
            <Button Content="关闭" Width="70" Height="32" FontSize="13"
                    FontFamily="Microsoft YaHei UI" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
